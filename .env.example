# App
NODE_ENV=development
PORT=3000
CMS_APP_DOMAIN=cms.localhost

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_catalog

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
